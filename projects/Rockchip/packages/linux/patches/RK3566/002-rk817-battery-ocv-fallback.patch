rk817-battery: fix OCV calibration units and recover from a stale low SOC.

dsoc and the SOC saved in the PMIC registers are in 1/1000 %, but
rk817_bat_vol_to_soc() returns %. rk817_bat_not_first_pwron() compared and
assigned the two directly in its OCV and force-calibration branches: the
comparisons against a max_soc_offset of 60 or 80 always fire (e.g. 58 against
72869), and the OCV estimate is then stored as e.g. 75 - which reads as 0%.
dsoc is saved back to the PMIC, which keeps its registers across reboots and
reflashes, so from then on every boot restores the same near-zero value and
the battery shows 0% "at random" with the pack half full. Scale the OCV
estimate to 1/1000 % in both branches.

Separately, Rockchip's U-Boot runs a fuel-gauge driver that primes the SOC
registers before Linux starts; mainline U-Boot, which this port builds, does
not, so the stored SOC can simply be 0.

A stored SOC below 1% cannot be right while the pack is above the power-off
voltage, so check for it at the common exit of rk817_bat_not_first_pwron() -
reached by every branch, including "initialized" and "halted" - and fall back
to an OCV estimate. This also heals PMICs that already hold a mis-scaled value.

--- a/drivers/power/supply/rk817_battery.c	2026-09-27 19:35:46.611617768 +0200
+++ b/drivers/power/supply/rk817_battery.c	2026-09-27 19:35:46.627619097 +0200
@@ -1645,12 +1645,14 @@
 	} else if (battery->is_ocv_calib) {
 		/* not initialized and poweroff_cnt above 30 min */
 		ocv_vol = rk817_bat_get_ocv_voltage(battery);
-		ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol);
+		/* dsoc and the saved SOC are in 1/1000 %, vol_to_soc() in % */
+		ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol) * 1000;
 		ocv_cap = rk817_bat_vol_to_cap(battery, ocv_vol);
 		pre_cap = ocv_cap;
 		battery->ocv_pre_dsoc = pre_soc;
 		battery->ocv_new_dsoc = ocv_soc;
-		if (abs(ocv_soc - pre_soc) >= battery->pdata->max_soc_offset) {
+		if (abs(ocv_soc - pre_soc) >=
+		    battery->pdata->max_soc_offset * 1000) {
 			battery->ocv_pre_dsoc = pre_soc;
 			battery->ocv_new_dsoc = ocv_soc;
 			battery->is_max_soc_offset = true;
@@ -1661,11 +1663,11 @@
 		BAT_INFO("OCV calib: cap=%d, rsoc=%d\n", ocv_cap, ocv_soc);
 	} else if (battery->pwroff_min > 0) {
 		ocv_vol = rk817_bat_get_ocv_voltage(battery);
-		ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol);
+		ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol) * 1000;
 		ocv_cap = rk817_bat_vol_to_cap(battery, ocv_vol);
 		battery->force_pre_dsoc = pre_soc;
 		battery->force_new_dsoc = ocv_soc;
-		if (abs(ocv_soc - pre_soc) >= 80) {
+		if (abs(ocv_soc - pre_soc) >= 80 * 1000) {
 			battery->is_force_calib = true;
 			BAT_INFO("dsoc force calib: %d -> %d\n",
 				 pre_soc, ocv_soc);
@@ -1674,6 +1676,22 @@
 		}
 	}
 finish:
+	/*
+	 * A stored SOC below 1% cannot be right while the pack sits above the
+	 * power-off voltage. It happens when Rockchip's U-Boot fuel gauge (which
+	 * mainline U-Boot lacks) never primed the SOC registers, and when an older
+	 * kernel saved an OCV estimate in % rather than 1/1000 %: that value is
+	 * restored on every boot and reads as 0% until something recalibrates.
+	 */
+	if (pre_soc < 1000 &&
+	    rk817_bat_get_battery_voltage(battery) > battery->pdata->pwroff_vol) {
+		ocv_vol = rk817_bat_get_ocv_voltage(battery);
+		ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol) * 1000;
+		ocv_cap = rk817_bat_vol_to_cap(battery, ocv_vol);
+		BAT_INFO("stale low dsoc, OCV calib: %d -> %d\n", pre_soc, ocv_soc);
+		pre_soc = ocv_soc;
+		pre_cap = ocv_cap;
+	}
 	battery->dsoc = pre_soc;
 	battery->nac = pre_cap;
 	if (battery->nac < 0)
